font-family = "JetBrains Mono Nerd Font"
font-size = 11

# Cursor
cursor-style = "bar"

# Padding
window-padding-x = 2
window-padding-y = 2

# No close confirmation
confirm-close-surface = false

# Shell
command = "fish"

# Theme
theme = "Matugen"

